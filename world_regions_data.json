{
  "version": 1,
  "descripcion": "Catálogo abierto y ampliable de provincias, estados, regiones y entidades administrativas equivalentes de Tinta Sapphic para 'Mi mundo sapphic'. Independiente de world_cities_data.json y de world_map_data.json. Solo valores confirmados y cartografiables; los ambiguos están en pendientes_verificacion y NO son regiones. Para añadir una región basta con añadir una entrada a \"regiones\": no hay que tocar index.html.",
  "campos": {
    "id": "único en todo el catálogo; convención <iso en minúsculas>-<slug> (ej. es-madrid)",
    "nombre": "nombre de la entidad; con pais_iso forma la clave de resolución (nombre y aliases, normalizados)",
    "pais / pais_iso": "país tal como se escribe en books_data.json y su ISO-2 de world_map_data.json",
    "tipo": "texto libre que se muestra tal cual (provincia, estado, región, prefectura, comunidad, territorio, condado, equivalente administrativo…). El código no debe depender de una lista cerrada",
    "lat / lon": "dato de referencia (WGS84, grados decimales): punto representativo INTERIOR elegido a mano, no centroide matemático",
    "x / y": "derivados de lat/lon con la proyección de proyeccion_mapa; si algo no cuadra, recalcular desde lat/lon",
    "aliases": "solo variantes ortográficas o traducciones verificadas del MISMO lugar; nunca equivalencias inferidas",
    "aliases_pais": "mapa nombre de país (como en books_data.json) -> ISO-2, para países sin polígono (Inglaterra, Escocia, Unión Soviética)"
  },
  "proyeccion_mapa": {
    "nombre": "Natural Earth",
    "viewBox": "0 0 1000 444",
    "nota": "x,y de cada ciudad están precalculados en el espacio SVG de world_map_data.json (calibración con sus marcadores: error medio <1 px). Derivados de lat/lon; si algo no cuadra, recalcular desde lat/lon.",
    "parametros": {
      "cx": 499.9187,
      "cy": 254.9876,
      "kx": 3.22876,
      "ky": 185.24272
    }
  },
